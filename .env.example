# 存储模式：json（无需数据库，开箱即用）| cockroach（生产 / Hackathon 提交）
STORAGE_MODE=cockroach

# CockroachDB（STORAGE_MODE=cockroach 时填写）
# 本地：postgresql://root@localhost:26257/defaultdb?sslmode=disable
# 应用会 SET DATABASE = qianhong（见 db/schema.sql）
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

# 古桥数据路径（与博物馆共用仓库根目录 data/）
BRIDGE_DATA_DIR=data

# LLM 模式：retrieval（仅本地检索）| openai（Kimi / DeepSeek）| bedrock（AWS）
LLM_MODE=openai

# OpenAI 兼容（Kimi：https://platform.moonshot.cn/console/api-keys）
# 国内：https://api.moonshot.cn/v1 ；国际：https://api.moonshot.ai/v1
OPENAI_API_BASE=https://api.moonshot.cn/v1
OPENAI_API_KEY=
OPENAI_MODEL=kimi-k2.5
# 备用旧模型：moonshot-v1-8k ；DeepSeek：OPENAI_API_BASE=https://api.deepseek.com/v1 OPENAI_MODEL=deepseek-chat

# AWS Bedrock（LLM_MODE=bedrock 时，需开通权限）
AWS_REGION=us-east-1
# 可选：不写则走默认凭证链（aws configure / IAM Role）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Amazon S3（Hackathon ≥1 AWS —— 扫桥存证 + 研学报告导出）
# aws s3 mb s3://你的桶名 --region us-east-1
S3_BUCKET=
S3_PREFIX=qianhong

# 服务
HOST=127.0.0.1
PORT=8787
