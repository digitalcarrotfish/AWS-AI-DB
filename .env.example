# 存储模式：json（无需数据库，开箱即用）| cockroach（生产 / Hackathon 提交）
STORAGE_MODE=json

# CockroachDB（STORAGE_MODE=cockroach 时填写）
# 本地 Docker：postgresql://root@localhost:26257/qianhong?sslmode=disable
DATABASE_URL=

# bridge 数据路径（默认指向前置项目）
BRIDGE_DATA_DIR=../bridge/data

# LLM 模式：retrieval（仅本地检索，无需 API）| openai（OpenAI 兼容）| bedrock（AWS）
LLM_MODE=retrieval

# OpenAI 兼容（Kimi / DeepSeek 等，LLM_MODE=openai 时）
OPENAI_API_BASE=https://api.moonshot.cn/v1
OPENAI_API_KEY=
OPENAI_MODEL=moonshot-v1-8k

# AWS Bedrock（LLM_MODE=bedrock 时，需开通权限）
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# 服务
HOST=127.0.0.1
PORT=8787
